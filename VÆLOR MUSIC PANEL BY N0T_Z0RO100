-- Board Logic
local isToggledOn = false
local toggleTweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function attemptVehicleSpawn()
    mainRE:FireServer("SegwaySmall")
    
    local vehicleSpawned = false
    local connections = {}
    
    local function onChildAdded(child)
        if child:IsA("Model") or child:IsA("Tool") then
            vehicleSpawned = true
        end
    end
    
    table.insert(connections, workspace.ChildAdded:Connect(onChildAdded))
    if workspace:FindFirstChild("Vehicles") then
        table.insert(connections, workspace.Vehicles.ChildAdded:Connect(onChildAdded))
    end
    if player.Character then
        table.insert(connections, player.Character.ChildAdded:Connect(onChildAdded))
    end
    
    task.wait(1.5)
    for _, conn in ipairs(connections) do conn:Disconnect() end
    
    if isToggledOn and not vehicleSpawned then
        mainRE:FireServer("SkateBoard")
    end
    
    -- Always fire board volume
    pcall(function()
        local volEvent = game:GetService("Players").LocalPlayer.PlayerGui.MainGUIHandler.MainAudio.Catalog.Header.VolumeContainer.VolumeChangeRequest
        volEvent:FireServer(100)
    end)
end

local function handleToggle()
    isToggledOn = not isToggledOn
    if isToggledOn then
        BoardBtn.Text = "🛹 Board: ON"
        TweenService:Create(BoardBtn, toggleTweenInfo, {BackgroundColor3 = Color3.fromRGB(46, 125, 50), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        task.spawn(attemptVehicleSpawn)
    else
        BoardBtn.Text = "🛹 Board: OFF"
        TweenService:Create(BoardBtn, toggleTweenInfo, {BackgroundColor3 = Color3.fromRGB(217, 217, 217), TextColor3 = Color3.fromRGB(40, 40, 40)}):Play()
        mainRE:FireServer("Delete NoMotorVehicle")
    end
end
